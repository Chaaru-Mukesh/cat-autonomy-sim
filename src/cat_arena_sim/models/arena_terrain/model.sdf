          <heightmap>
            <uri>model://arena_terrain/arena_heightmap.pgm</uri>
            <size>9 5 0.30</size>
            <pos>0 0 -0.30</pos>
          </heightmap>
        </geometry>
        <material>
          <ambient>0.48 0.34 0.20 1</ambient>
          <diffuse>0.62 0.46 0.28 1</diffuse>
        </material>
      </visual>
    </link>
