<?xml version="1.0"?>
<sdf version="1.8">
  <model name="arena_terrain">
    <static>true</static>
    <link name="sand_bed">
      <collision name="terrain_collision">
        <geometry>
          <heightmap>
            <uri>model://arena_terrain/arena_heightmap.pgm</uri>
            <size>9 5 0.30</size>
            <pos>0 0 -0.30</pos>
          </heightmap>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.85</mu>
              <mu2>0.75</mu2>
            </ode>
          </friction>
